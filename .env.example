# Copy this file to ".env" and put your real key there.
# NEVER commit ".env" to Git. Only ".env.example" (this file, without real keys) is committed.

# Which provider to use: groq or gemini
LLM_PROVIDER=groq

# Groq  -> create a key at https://console.groq.com
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Gemini -> create a key at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
